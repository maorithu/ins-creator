# Copy this file to `.env` (same folder) and fill in your values.
# Everything is optional — without keys the app still works with local uploads,
# the built-in demo dataset, built-in music, and a local copywriting engine.

# --- Google Gemini (AI captions, hooks & photo descriptions) ---
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash

# --- Google Photos import (OAuth "Desktop/Web" client from Google Cloud Console) ---
# Authorized redirect URI must include: http://127.0.0.1:8000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Optional: cloud music generation (otherwise a local synthesizer is used) ---
# ELEVENLABS_API_KEY=
